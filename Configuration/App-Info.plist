<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Wattage scans for nearby Bluetooth accessories only when you start a scan.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Wattage browses for devices advertising common services on your local Wi-Fi when you choose Discover.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_airplay._tcp</string>
		<string>_ipp._tcp</string>
		<string>_smb._tcp</string>
		<string>_ssh._tcp</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
